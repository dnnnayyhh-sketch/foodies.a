    let cart = {};
    let orderType = "توصيل طلب";
    let activeCategory = "all";

    // عرض الأطباق
    function renderMenu() {
      const container = document.getElementById('menuContainer');
      const q = document.getElementById('searchInput').value.trim().toLowerCase();

      const filtered = menuData.filter(item => {
        const matchCat = (activeCategory === "all") || (item.cat === activeCategory);
        const matchSearch = item.name.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q);
        return matchCat && matchSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:30px; color:#94a3b8; font-size:0.85rem;">لا توجد وجبات مطابقة للبحث.</div>`;
        return;
      }

      container.innerHTML = filtered.map(item => `
        <div class="food-card">
          <img src="${item.img}" class="food-thumb" alt="${item.name}" loading="lazy">
          <div class="food-details">
            <div class="food-cat-badge">${item.cat}</div>
            <div class="food-name">${item.name}</div>
            <div class="food-desc">${item.desc}</div>
          </div>
          <button class="btn-add" title="إضافة للطلب" onclick="addToCart('${item.name}')">+</button>
        </div>
      `).join('');
    }

    // تصفية حسب التصنيف
    function selectCat(cat, btn) {
      activeCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderMenu();
    }

    // تصفية بالبحث
    function filterMenu() {
      renderMenu();
    }

    // إدارة السلة
    function addToCart(itemName) {
      cart[itemName] = (cart[itemName] || 0) + 1;
      updateCartUI();
    }

    function changeQty(itemName, delta) {
      if (!cart[itemName]) return;
      cart[itemName] += delta;
      if (cart[itemName] <= 0) {
        delete cart[itemName];
      }
      updateCartUI();
    }

    function updateCartUI() {
      const badge = document.getElementById('cartCountBadge');
      const totalItems = Object.values(cart).reduce((a, b) => a + b, 0);

      if (totalItems > 0) {
        badge.innerText = totalItems;
        badge.style.display = 'block';
      } else {
        badge.style.display = 'none';
      }

      const listContainer = document.getElementById('cartItemsList');
      const itemsKeys = Object.keys(cart);

      if (itemsKeys.length === 0) {
        listContainer.innerHTML = `<p style="font-size:0.8rem; color:var(--text-muted); text-align:center; padding:16px;">السلة فارغة حالياً.. تصفح المنيو وأضف وجباتك المفضلة!</p>`;
        return;
      }

      listContainer.innerHTML = itemsKeys.map(k => `
        <div class="cart-item">
          <div class="cart-item-title">${k}</div>
          <div class="cart-ctrls">
            <button class="btn-qty" onclick="changeQty('${k}', -1)">-</button>
            <span style="font-weight:800; font-size:0.95rem; min-width:18px; text-align:center;">${cart[k]}</span>
            <button class="btn-qty" onclick="changeQty('${k}', 1)">+</button>
          </div>
        </div>
      `).join('');
    }

    function setOrderType(type) {
      orderType = type;
      document.getElementById('optDelivery').classList.toggle('active', type === 'توصيل طلب');
      document.getElementById('optTakeaway').classList.toggle('active', type === 'استلام من الفرع');
    }

    // التبديل بين التبويبات
    function switchTab(tabId, btn) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));

      document.getElementById('tab-' + tabId).classList.add('active');
      btn.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // إرسال الطلب عبر الواتساب إلى رقم المطعم
    function sendWhatsAppOrder() {
      const itemsKeys = Object.keys(cart);
      if (itemsKeys.length === 0) {
        alert("يرجى اختيار وجبة واحدة على الأقل قبل تأكيد الطلب!");
        return;
      }

      const custName = document.getElementById('custName').value.trim();
      const custNotes = document.getElementById('custNotes').value.trim();

      if (!custName) {
        alert("يرجى تدوين اسمك الكريم والعنوان أو رقم الطاولة.");
        document.getElementById('custName').focus();
        return;
      }

      let msg = `*طلب جديد من منيو foodies.a الإلكتروني* 🍔✨\n\n`;
      msg += `📌 *نوع الطلب:* ${orderType}\n`;
      msg += `👤 *العميل / العنوان:* ${custName}\n`;
      if (custNotes) msg += `📝 *ملاحظات:* ${custNotes}\n`;
      msg += `\n*قائمة الوجبات المطلوبة:*\n`;

      itemsKeys.forEach((k, i) => {
        msg += `${i + 1}. ${k} (العدد: ${cart[k]})\n`;
      });

      msg += `\nيرجى تأكيد استلام الطلب وبدء التحضير. شكراً لكم!`;

      const phone = "963998187778";
      const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
    }

    // بدء العرض عند تحميل الصفحة
    window.onload = () => {
      renderMenu();
    };
  </script>

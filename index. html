      { name: "برغر آنجوس", cat: "برغر", desc: "شريحة لحم بلاك آنجوس معتق وفاخر لأصحاب الذوق الرفيع", img: "https://images.unsplash.com/photo-1583032015879-c5c24e037f40?auto=format&fit=crop&w=400&q=80" },
